oject/image_captioning/descriptions.txt\"\n","clean_descriptions = load_clean_descriptions(desc_path)\n","\n","# Get only image IDs that exist in both features and descriptions\n","valid_image_ids = [img_id for img_id in clean_descriptions if img_id in features]\n","\n","# Split into 90% train, 10% test\n","random.seed(42)\n","random.shuffle(valid_image_ids)\n","split = int(len(valid_image_ids) * 0.9)\n","train_ids = valid_image_ids[:split]\n","test_ids = valid_image_ids[split:]\n","\n","# Split descriptions and features\n","train_descriptions = {k: clean_descriptions[k] for k in train_ids}\n","test_descriptions = {k: clean_descriptions[k] for k in test_ids}\n","train_features = {k: features[k] for k in train_ids}\n","test_features = {k: features[k] for k in test_ids}\n","\n","print(f\"Train Descriptions: {len(train_descriptions)} | Test Descriptions: {len(test_descriptions)}\")\n","print(f\"Train Features: {len(train_features)} | Test Features: {len(test_features)}\")\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"6bStuEBkpNwz"},"outputs":[],"source":["from keras.models import load_model\n","from pickle import load\n","\n","# Load tokenizer\n","tokenizer = load(open(\"/content/drive/MyDrive/CPS_4801_Spring25/Final_project/image_captioning/tokenizer.p\", \"rb\"))\n","max_length = 34  # Update if needed\n","\n","# Load model (latest .keras file after training)\n","model = load_model(\"/content/drive/MyDrive/CPS_4801_Spring25/Final_project/image_captioning/models/model_9.keras\")\n"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Oac596fzFzP-"},"outputs":[],"source":["import numpy as np\n","from tensorflow.keras.preprocessing.sequence import pad_sequences\n","\n","# Map index to word\n","def word_for_id(integer, tokenizer):\n","    for word, index in tokenizer.word_index.items():\n","        if index == integer:\n","            return word\n","    return None\n","\n","# Greedy Search\n","def generate_caption(model, tokenizer, photo, max_length):\n","    in_text = 'startseq'\n","    for _ in range(max_length):\n","        sequence = tokenizer.texts_to_sequences([in_text])[0]\n","        sequence = pad_sequences([sequence], maxlen=max_length)\n","        yhat = model.predict([photo, sequence], verbose=0)\n","        yhat = np.argmax(yhat)\n","        word = word_for_id(yhat, tokenizer)\n","        if word is None:\n","            break\n","        in_text += ' ' + word\n","        if word == 'endseq':\n","            break\n","    return in_text\n","\n","# Beam Search\n","def beam_search_caption(model, tokenizer, photo, max_length, beam_width=3):\n","    sequences = [[['startseq'], 0.0]]\n","    for _ in range(max_length):\n","        all_candidates = []\n","        for seq, score in sequences:\n","            sequence = tokenizer.texts_to_sequences([seq])[0]\n","            sequence = pad_sequences([sequence], maxlen=max_length)\n","            preds = model.predict([photo, sequence], verbose=0)[0]\n","            top_preds = np.argsort(preds)[-beam_width:]\n","            for word_id in top_preds:\n","                word = word_for_id(word_id, tokenizer)\n","                if word is None:\n","                    continue\n","                new_seq = seq + [word]\n","                new_score = score + np.log(preds[word_id])\n","                all_candidates.append([new_seq, new_score])\n","        sequences = sorted(all_candidates, key=lambda tup: tup[1], reverse=True)[:beam_width]\n","    final = sequences[0][0]\n","    return \" \".join(final[1:-1])  # clean startseq/endseq\n","\n","# Top-k Sampling\n","def top_k_sampling_caption(model, tokenizer, photo, max_length, k=5):\n","    in_text = 'startseq'\n","    for _ in range(max_length):\n","        sequence = tokenizer.texts_to_sequences([in_text])[0]\n","        sequence = pad_sequences([sequence], maxlen=max_length)\n","        preds = model.predict([photo, sequence], verbose=0)[0]\n","        top_k_indices = np.argsort(preds)[-k:]\n"," 